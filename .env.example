# Harunobu 環境変数設定
# このファイルを .env にコピーして使用してください: cp .env.example .env

# --- AI機能設定 ---
# AI補完機能を無効化する場合は 1 に設定（デフォルト: 無効）
# テスト・オフライン環境では無効化を推奨
# HARUNOBU_AI_DISABLED=1

# --- AIプロバイダー設定 ---
# 使用するAIプロバイダー: gemini / openai / anthropic（デフォルト: gemini）
# HARUNOBU_AI_PROVIDER=gemini

# モデル名オーバーライド（省略時はプロバイダーのデフォルト）
# HARUNOBU_AI_MODEL=gemini-2.5-pro

# フォールバックモデル（省略時はなし）
# HARUNOBU_AI_FALLBACK_MODEL=gemini-2.0-flash

# --- Gemini設定（HARUNOBU_AI_PROVIDER=gemini の場合）---
# Google AI Studio APIキー（Vertex AIを使わない場合）
# GOOGLE_API_KEY=your-api-key-here

# Vertex AIを使用する場合
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-northeast1

# --- OpenAI設定（HARUNOBU_AI_PROVIDER=openai の場合）---
# OPENAI_API_KEY=your-api-key-here

# --- OpenAI互換エンドポイント / ローカルLLM（Ollama / vLLM / LM Studio / llama.cpp 等）---
# HARUNOBU_AI_PROVIDER=openai と組み合わせて、接続先をOpenAI互換サーバに切り替える
# （OPENAI_BASE_URL / OPENAI_API_BASE も読みます。HARUNOBU_AI_API_BASE が優先）
# HARUNOBU_AI_API_BASE=http://localhost:11434/v1
# HARUNOBU_AI_MODEL=qwen2.5:7b
# APIキー（ローカルサーバでキー不要なら省略可。省略時はダミーキーを送ります）
# HARUNOBU_AI_API_KEY=
# サーバが response_format={"type":"json_object"} に未対応なら 0 に設定（デフォルト: 1）
# HARUNOBU_AI_JSON_MODE=0

# --- Anthropic設定（HARUNOBU_AI_PROVIDER=anthropic の場合）---
# ANTHROPIC_API_KEY=your-api-key-here
